# Server
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=aws-1-eu-central-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_FILENAME=.tmp/data.db
DATABASE_SSL_REJECT_UNAUTHORIZED=false
LOCAL_POSTGRES_PASSWORD=
# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_ENCRYPTION_KEY=

# Google Sign IN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:1337/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ─── Deneme sınavları (see README → Deneme sınavları) ───────────────────────
# Public site address used in report links (falls back to FRONTEND_URL)
PUBLIC_SITE_URL=
# Report comment writer: deepseek | anthropic | gemini | openai (default deepseek → deepseek-flash)
AI_PROVIDER=
AI_MODEL=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Report link by SMS (Netgsm). MSGHEADER = approved sender name
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
# Number for the WhatsApp button on reports (e.g. 905551234567)
WHATSAPP_NUMBER=
# New report request e-mails to the teacher
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
# Days to keep report requests and results (default 365, minimum 90)
DENEME_RETENTION_DAYS=
