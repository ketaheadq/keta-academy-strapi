{
	"kind": "collectionType",
	"collectionName": "rapor_talepleri",
	"info": {
		"singularName": "rapor-talebi",
		"pluralName": "rapor-talepleri",
		"displayName": "Rapor Talebi",
		"description": "Deneme raporu için bırakılan numaralar (hocanın arama listesi)."
	},
	"options": {
		"draftAndPublish": false
	},
	"pluginOptions": {},
	"attributes": {
		"adSoyad": {
			"type": "string",
			"required": true
		},
		"telefon": {
			"type": "string",
			"required": true
		},
		"yakinlik": {
			"type": "enumeration",
			"enum": ["Veli", "Ogrenci", "Diger"],
			"required": true
		},
		"durum": {
			"type": "enumeration",
			"enum": ["Aranacak", "Arandi", "Ulasilamadi", "Gorusme_yapildi", "Paket_aldi", "Uygun_degil"],
			"default": "Aranacak"
		},
		"raporLinki": {
			"type": "string"
		},
		"denemeBaslik": {
			"type": "string"
		},
		"net": {
			"type": "decimal"
		},
		"zayifKonular": {
			"type": "text"
		},
		"kaynak": {
			"type": "string"
		},
		"raporIzni": {
			"type": "boolean",
			"default": false
		},
		"aramaIzni": {
			"type": "boolean",
			"default": false
		},
		"aramaNotlari": {
			"type": "component",
			"component": "rapor.arama-notu",
			"repeatable": true
		},
		"yapayZekaYorumu": {
			"type": "json"
		},
		"hocaNotu": {
			"type": "text"
		},
		"yapayZeka": {
			"type": "string"
		},
		"yapayZekaHatasi": {
			"type": "text"
		},
		"bildirimHatasi": {
			"type": "text"
		},
		"raporAcilmaSayisi": {
			"type": "integer",
			"default": 0
		},
		"ilkAcilma": {
			"type": "datetime"
		},
		"sinavSonucu": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "api::sinav-sonucu.sinav-sonucu"
		},
		"raporVerisi": {
			"type": "json"
		},
		"raporAnahtari": {
			"type": "string",
			"unique": true
		},
		"kullanici": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user",
			"private": true
		}
	}
}
