{
	"kind": "collectionType",
	"collectionName": "quiz_progresses",
	"info": {
		"singularName": "quiz-progress",
		"pluralName": "quiz-progresses",
		"displayName": "QuizProgress"
	},
	"options": {
		"draftAndPublish": false
	},
	"pluginOptions": {},
	"attributes": {
		"learner": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user",
			"private": true
		},
		"quiz": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "api::quiz.quiz"
		},
		"result": { "type": "json", "private": true },
		"completedAt": { "type": "datetime" },
		"score": {
			"type": "integer"
		},
		"quiz_status": {
			"type": "enumeration",
			"enum": ["not_started", "in_progress", "completed"]
		},
		"user_plus_quiz_id": {
			"private": true,
			"type": "string",
			"required": true,
			"unique": true
		}
	}
}
